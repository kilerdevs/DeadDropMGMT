# Caddy front for the PHP-FPM variant. Same protections as the nginx config.
# Caddy would happily do automatic HTTPS on a public hostname — for local
# testing this listens on :80; point your domain at it and swap :80 for the
# hostname to get TLS terminated here instead of an external proxy.

:80 {
	root * /var/www/html

	# Map zone files are served by secret names only (zone_<id>_<token>.pmtiles);
	# guessable legacy names, partial downloads and engine sidecars never are.
	@zonelegacy path_regexp ^/tiles/zone_[0-9]+\.(pmtiles|part)$
	respond @zonelegacy 403
	@zonepart path_regexp ^/tiles/.*\.(part|plan|tiles|tmp|leaves)$
	respond @zonepart 403

	# Zone uploads land under server-generated .pmtiles names only, but the
	# directory is app-writable: nothing PHP-ish under /tiles/ ever reaches
	# FPM, whatever its name.
	@zonephp path_regexp ^/tiles/.*\.(php[0-9]?|phtml|phar)$
	respond @zonephp 403

	# INSTALL_UNLOCK holds the installer's rotating upgrade token: never serve.
	@blocked path /includes/* /logs/* /cron/* /tools/* /cache/* /data/* /docker/* /e2e/* /tests/* /backups/* /config.php /config.php.example /setup.sql /INSTALL_UNLOCK /build-info.json /composer.* /package*.json /playwright.config.js /phpstan.neon /auto-update.* /Dockerfile* /docker-compose* /.htaccess /.ht*
	respond @blocked 403
	# Dotfiles and VCS metadata (.git/, .env, .github/, ...), except .well-known.
	# (Go regexps have no lookahead, hence the separate exclusion.)
	@dotfiles {
		path_regexp /\.
		not path /.well-known/*
	}
	respond @dotfiles 404

	# Uploaded images must never reach PHP-FPM, whatever their name is. A
	# regexp: Caddy's path "*" does not cross "/", and photos are nested
	# (uploads/<order>/<name>).
	@upload_php path_regexp ^/uploads/.*\.(php[0-9]?|phtml|phar)$
	respond @upload_php 403

	# Static files and error pages never pass through PHP's header layer.
	header X-Content-Type-Options "nosniff"

	# Immutable static assets: vendored libs, glyphs, zone archives (fresh
	# secret names per build) and ?v=-busted first-party files. Uploads stay
	# no-store (bearer URLs); HTML/PHP untouched.
	@immutable path /maplibre/* /fonts/* /admin/vendor/* /tiles/*.pmtiles
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	# Bandwidth for recipients on phones: compress text assets (maplibre-gl.js
	# 1 MB -> ~265 KB). Tile PNGs (tile_proxy.php), /tiles/*.pmtiles and
	# /uploads/* are already compressed — and compression breaks Range
	# requests — so they are excluded; everything else compressible by
	# extension is fair game, including dynamic HTML (*.php).
	@encodable {
		path *.js *.mjs *.css *.html *.htm *.php *.svg *.json *.txt *.xml
		not path /admin/tile_proxy.php /tiles/* /uploads/* /cache/*
	}
	encode @encodable zstd gzip

	# Same capability-URL reasoning as the Apache/nginx notes: bearer links
	# must not persist in caches.
	@uploads path /uploads/*
	header @uploads Cache-Control "private, no-store"
	header @uploads Referrer-Policy "no-referrer"

	request_body {
		max_size 512MB
	}

	php_fastcgi fpm:9000 {
		read_timeout 60s
	}
	file_server
}
