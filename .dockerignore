.git
.github
# Tests stay out of the image — except schema_loader.php, which the Dockerfiles
# COPY explicitly for first-boot schema setup. NOTE: a file cannot be
# re-included from under an excluded parent directory, so the directory is
# excluded by contents (tests/*), not as a whole.
tests/*
!tests/schema_loader.php
config.php
logs/*
# logs/.htaccess ships: it keeps logs/ closed on hosts without mod_rewrite.
!logs/.htaccess
uploads/*
# ... but the uploads/.htaccess IS load-bearing (PHP-execution block,
# image-only allow-list, no-store on capability URLs): uploads/ must stay
# servable, so no vhost-level rule can cover it. Tracked via git add -f.
!uploads/.htaccess
cache/*
# Same for the tile cache: cache/ must stay on disk for tile_proxy.php, but
# its .htaccess (deny direct URLs that would bypass the admin gate) ships.
!cache/.htaccess
# Dev-only Composer tooling (php-code-coverage) must never ship: it is a
# supply-chain surface with no runtime purpose (ADR-001).
vendor/
composer.lock
*.md
prompt.txt
docker-compose*.yml
Dockerfile*
.env

build-info.json
# Ops leftovers on the build host never ship: pre-upgrade DB dumps written by
# auto-update.sh (every order, hashes, audit data) would otherwise be baked
# into an image layer on the very next build.
backups/*
!backups/.htaccess
auto-update.*
# Runtime artifacts and host tooling: zone extracts, downloaded map data,
# JS tooling, test reports and dependency manifests. Any of these next to
# the Dockerfile busts the COPY . layer cache — and the smoke job would then
# test an image the CVE scan never saw (and even serve some of it, e.g. an
# SBOM dropped in the workspace, from the docroot).
tiles/*.pmtiles
data/maps/*
node_modules/
e2e/
test-results/
playwright-report/
coverage-html/
*.phar
package*.json
playwright.config.js
phpstan.neon
.php-cs-fixer.php
composer.json
.semgrep*
fromftp/
.claude/
