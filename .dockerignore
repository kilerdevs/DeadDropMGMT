.git
.github
# Tests stay out of the image — except schema_loader.php, which the Dockerfiles
# COPY explicitly for first-boot schema setup. NOTE: a file cannot be
# re-included from under an excluded parent directory, so the directory is
# excluded by contents (tests/*), not as a whole.
tests/*
!tests/schema_loader.php
config.php
logs/*
uploads/*
# ... but the uploads/.htaccess IS load-bearing (PHP-execution block,
# image-only allow-list, no-store on capability URLs): uploads/ must stay
# servable, so no vhost-level rule can cover it. Tracked via git add -f.
!uploads/.htaccess
cache/*
# Same for the tile cache: cache/ must stay on disk for tile_proxy.php, but
# its .htaccess (deny direct URLs that would bypass the admin gate) ships.
!cache/.htaccess
# Dev-only Composer tooling (php-code-coverage) must never ship: it is a
# supply-chain surface with no runtime purpose (ADR-001).
vendor/
composer.lock
*.md
prompt.txt
docker-compose*.yml
Dockerfile*
.env
