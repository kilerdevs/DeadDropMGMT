root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = space
indent_size = 4

[*.{yml,yaml,neon}]
indent_style = space
indent_size = 2

[*.{js,css,html}]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 4

[*.{md,sql}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
