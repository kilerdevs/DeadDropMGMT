# Compose overrides — copy to .env and adjust. Everything has a working default.
#APP_PORT=2137
#DB_PASS=deaddrop-db
#DB_ROOT_PASS=deaddrop-root
# 64-char hex AES key; leave unset to auto-generate + persist on the config volume
#DDMGMT_AES_KEY_HEX=
# Require this token to create the first owner (recommended before exposing a fresh instance)
#DDMGMT_SETUP_TOKEN=
# Automatic OSM proxy discovery (first-run pool + replacing failed proxies): 0 = off
#DDMGMT_PROXY_HEAL=1
# Page-visit pseudo-cron: 0 = off (only if you run real cron)
#DDMGMT_PSEUDO_CRON=1
