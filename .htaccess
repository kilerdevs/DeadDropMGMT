Options -Indexes

# Custom error pages
ErrorDocument 400 /error/400.php
ErrorDocument 403 /error/403.php
ErrorDocument 404 /error/404.php
ErrorDocument 500 /error/500.php
ErrorDocument 503 /error/503.php

# Explicitly serve static assets (required on byethost — server-level config denies by default).
# pbf (map glyphs), pmtiles (zone files) and json (map style) must be listed
# too, or deny-by-default hosts answer 403 for them.
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|pbf|pmtiles|json)$">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all granted
</FilesMatch>

# Ensure correct MIME types so nosniff doesn't block them
<IfModule mod_mime.c>
    AddType text/css                  .css
    AddType application/javascript    .js
    AddType image/png                 .png
    AddType image/jpeg                .jpg .jpeg
    AddType image/gif                 .gif
    AddType image/svg+xml             .svg
    AddType font/woff                 .woff
    AddType font/woff2                .woff2
    AddType application/x-protobuf    .pbf
    AddType application/json          .json
</IfModule>

# Compress text assets for recipients on slow links (guarded: hosts without
# mod_deflate skip this instead of 500ing). Glyphs drop ~40% this way.
# Uploads (JPEG/PNG) and .pmtiles are already compressed — and deflating
# them breaks Range requests — so they stay out.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript application/json application/xml image/svg+xml application/x-protobuf text/html
</IfModule>

# Protect sensitive files from direct access. Kept OUTSIDE <IfModule
# mod_rewrite.c>: hosts without mod_rewrite skip that block entirely.
<FilesMatch "^(config\.php|config\.php\.example|setup\.sql|build-info\.json|composer\.(json|lock)|package(-lock)?\.json|playwright\.config\.js|phpstan\.neon|\.php-cs-fixer\.php|auto-update\.(sh|log)|Dockerfile[^/]*|docker-compose[^/]*\.yml|INSTALL_UNLOCK|\.__install_dl\.zip(\.part)?)$">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all denied
</FilesMatch>
# Dotfiles and VCS metadata (.git/, .env, .github/, ...) — except .well-known.
<IfModule mod_alias.c>
    RedirectMatch 404 "(?:^|/)\.(?!well-known/)[^/]+(/|$)"
</IfModule>

# Protect directories that should never be web-accessible
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to includes/ directory
    RewriteRule ^includes/ - [F,L]

    # Block access to logs/ directory (logs/.htaccess denies it too, so it
    # stays closed without mod_rewrite)
    RewriteRule ^logs/ - [F,L]

    # Block access to the tile cache: tiles are served exclusively through
    # admin/tile_proxy.php (authenticated), never by direct URL.
    RewriteRule ^cache/ - [F,L]

    # Developer/ops material never ships as web content: cron workers, CLI tools, the
    # container journey, browser-test seeds, the PHP test suites, CI config
    # and local backups. The CLI scripts also refuse non-CLI SAPIs themselves
    # (PHP_SAPI guard), so a server that ignores this file still cannot be
    # made to run them.
    RewriteRule ^(cron|tools|docker|e2e|tests|backups|data|\.semgrep|\.github)/ - [F,L]
    RewriteRule ^(setup\.sql|build-info\.json|composer\.(json|lock)|package(-lock)?\.json|playwright\.config\.js|phpstan\.neon|\.php-cs-fixer\.php|auto-update\.(sh|log)|config\.php\.example|Dockerfile[^/]*|docker-compose[^/]*\.yml)$ - [F,L]
</IfModule>

# Map-engine sidecars (.plan/.tiles/.part/.tmp/.leaves) carry the proxy URL
# and exact byte layout — never web content. nginx/Caddy deny them by
# extension; Apache needs the same here (the static-asset grant above does
# not cover these types, but permissive hosts serve unknown types happily).
<FilesMatch "\.(plan|tiles|part|tmp|leaves)$">
    Require all denied
</FilesMatch>

# Protect this file
<Files ".htaccess">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all denied
</Files>

# Security headers — the error pages and static assets don't go through PHP's
# set_security_headers(), so Apache covers them here. PHP pages send the same
# headers themselves; a duplicate nosniff is harmless (browsers take the last),
# while X-Frame-Options duplicates ARE flagged by scanners — hence XFO stays
# scoped to /error/ only.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY" "expr=%{REQUEST_URI} =~ m#^/error/#"
</IfModule>
