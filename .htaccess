Options -Indexes

# Custom error pages
ErrorDocument 400 /error/400.php
ErrorDocument 403 /error/403.php
ErrorDocument 404 /error/404.php
ErrorDocument 500 /error/500.php
ErrorDocument 503 /error/503.php

# Explicitly serve static assets (required on byethost — server-level config denies by default)
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all granted
</FilesMatch>

# Ensure correct MIME types so nosniff doesn't block them
<IfModule mod_mime.c>
    AddType text/css                  .css
    AddType application/javascript    .js
    AddType image/png                 .png
    AddType image/jpeg                .jpg .jpeg
    AddType image/gif                 .gif
    AddType image/svg+xml             .svg
    AddType font/woff                 .woff
    AddType font/woff2                .woff2
</IfModule>

# Protect sensitive files from direct access
<FilesMatch "^(config\.php)$">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all denied
</FilesMatch>

# Protect directories that should never be web-accessible
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to includes/ directory
    RewriteRule ^includes/ - [F,L]

    # Block access to logs/ directory
    RewriteRule ^logs/ - [F,L]
</IfModule>

# Protect this file
<Files ".htaccess">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all denied
</Files>

# Security headers — the error pages and static assets don't go through PHP's
# set_security_headers(), so Apache covers them here. PHP pages send the same
# headers themselves; a duplicate nosniff is harmless (browsers take the last),
# while X-Frame-Options duplicates ARE flagged by scanners — hence XFO stays
# scoped to /error/ only.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY" "expr=%{REQUEST_URI} =~ m#^/error/#"
</IfModule>
