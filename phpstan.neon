parameters:
	level: 5
	bootstrapFiles:
		- config.php
	paths:
		- includes
		- admin
		- cron
		- tools
		- index.php
		- receive.php
	excludePaths:
		# error pages and the gitignored local config are trivial / environment
		- error
		- config.php
		- docker
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# DB_TLS constants come from _secret() — locally they collapse to the
		# empty fallback, so PHPStan proves the guard "always false". In any
		# real deployment the env var is set; the comparison is the point.
		-
			identifier: notIdentical.alwaysFalse
			path: includes/db.php
