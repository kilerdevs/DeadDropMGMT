parameters:
	level: 5
	bootstrapFiles:
		- config.php
	paths:
		- includes
		- admin
		- cron
		- tools
		- index.php
		- receive.php
	excludePaths:
		# error pages and the gitignored local config are trivial / environment
		- error
		- config.php
		- docker
	treatPhpDocTypesAsCertain: false
	# The TLS option matrix lives in the pure db_options() factory, so no
	# environment-dependent "always false" suppressions are needed anymore.
