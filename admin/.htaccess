Options -Indexes
DirectoryIndex index.php

# Block dotfiles (.htaccess, .env, etc.)
<FilesMatch "^\.">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
