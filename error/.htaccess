Options -Indexes

<FilesMatch "\.php$">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all granted
</FilesMatch>

<FilesMatch "\.htaccess$">
    # Apache 2.4 authz (Order/Allow/Deny is deprecated mod_access_compat syntax)
    Require all denied
</FilesMatch>
