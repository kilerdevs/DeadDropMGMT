<?php
// Example configuration — copy to config.php and fill in real values.
// config.php is gitignored, so this file is the committed template.
//
// Secrets are read from environment variables first (DDMGMT_*), the literal
// fallbacks below keep zero-config installs working. For production prefer
// environment variables so secrets never live inside the working tree.

function _secret(string $env_name, string $fallback): string {
    $v = getenv($env_name);
    return ($v !== false && $v !== '') ? $v : $fallback;
}

// ── Database ─────────────────────────────────────────────────────────────────
define('DB_HOST',    _secret('DDMGMT_DB_HOST', 'localhost'));
define('DB_PORT',    _secret('DDMGMT_DB_PORT', '3306'));
define('DB_NAME',    _secret('DDMGMT_DB_NAME', 'deaddrops'));
define('DB_USER',    _secret('DDMGMT_DB_USER', 'root'));
define('DB_PASS',    _secret('DDMGMT_DB_PASS', ''));
define('DB_CHARSET', 'utf8mb4');

// ── Database TLS (distributed deployments) ───────────────────────────────────
// Same-host installs need none of these. For app and DB on different hosts,
// point DDMGMT_DB_SSL_CA at the CA bundle that signed the server certificate;
// client certificates are optional. Verification can only be disabled
// explicitly (never do it over untrusted networks).
define('DB_SSL_CA',     _secret('DDMGMT_DB_SSL_CA', ''));
define('DB_SSL_CERT',   _secret('DDMGMT_DB_SSL_CERT', ''));
define('DB_SSL_KEY',    _secret('DDMGMT_DB_SSL_KEY', ''));
define('DB_SSL_VERIFY', _secret('DDMGMT_DB_SSL_VERIFY_CERT', '1') === '1');

// ── AES-256-GCM key (32 bytes stored as 64-char hex) ─────────────────────────
// Generate:  php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
define('AES_KEY_HEX', _secret('DDMGMT_AES_KEY_HEX', 'REPLACE_WITH_64_HEX_CHARS_FROM_PHP_R_ABOVE__________'));

// ── Site identity ────────────────────────────────────────────────────────────
// Fallback used only if the DB settings table is empty or unreachable.
// define('SITE_NAME', 'MGT');

// ── Error logging ─────────────────────────────────────────────────────────────
define('ERROR_LOG_PATH', __DIR__ . '/logs/error.log');
define('APP_LOG_PATH',   __DIR__ . '/logs/app.log');

// Structured JSONL application log with tamper-evident hash chain.
require_once __DIR__ . '/includes/logger.php';

// ── Session ───────────────────────────────────────────────────────────────────
define('SESSION_NAME',     'ddmgmt');
define('SESSION_LIFETIME', 3600); // seconds

// ── Rate limiting ─────────────────────────────────────────────────────────────
define('RATE_LIMIT_MAX',    10);
define('RATE_LIMIT_WINDOW', 900); // 15 minutes

// Fixed bcrypt hash of an unknown random secret. Verifying submitted
// credentials against it when the account/token does not exist equalizes CPU
// cost between "unknown identifier" and "wrong password" — enumeration
// resistance without sleeps or other timing hacks. The plaintext it hashes
// was never stored anywhere.
define('DUMMY_AUTH_HASH', '$2y$12$' . 'JOfiPnfCGcrXUxs5MiJ81.' . 'vMz8Qs6n2qJpelljzdwVQJ8TVatrxTC');

// Fixed base32 TOTP secret for the same purpose on the 2FA step: a missing
// account or undecryptable secret still burns one full verification.
define('DUMMY_TOTP_SECRET', 'KRZGS5DQNZQXG2DDNZUW453FOV2GKY3O');

// ── Timezone (UTC everywhere so PHP + MySQL agree regardless of server clock) ─
date_default_timezone_set('UTC');

// ── PHP error config ──────────────────────────────────────────────────────────
ini_set('display_errors', '0');
ini_set('log_errors',     '1');
ini_set('error_log',       ERROR_LOG_PATH);

// ── Client IP resolution (used by rate limiting, audit log) ────────────────
// Proxy headers (CF-Connecting-IP, X-Forwarded-For, X-Real-IP) are trusted
// ONLY when the deployment says so: set DDMGMT_TRUST_PROXY=1 when the app
// runs behind a reverse proxy or CDN that OVERWRITES these headers. Without
// it, any client could spoof its address and sidestep IP rate limiting or
// poison the audit log. Values are always validated as literal IPs; without
// proxy trust the TCP peer address (REMOTE_ADDR) is the only truth.
function get_client_ip(): string {
    if (_secret('DDMGMT_TRUST_PROXY', '0') === '1') {
        $candidates = [
            'HTTP_CF_CONNECTING_IP',
            'HTTP_X_FORWARDED_FOR',
            'HTTP_X_REAL_IP',
        ];
        foreach ($candidates as $key) {
            if (!empty($_SERVER[$key])) {
                $ip = trim(explode(',', $_SERVER[$key])[0]);
                if (filter_var($ip, FILTER_VALIDATE_IP)) {
                    return $ip;
                }
            }
        }
    }
    return (string)($_SERVER['REMOTE_ADDR'] ?? '0.0.0.0');
}

// ── Request scheme detection (session cookie "secure" flag, HSTS) ────────────
// Behind a TLS-terminating reverse proxy PHP sees plain HTTP, so $_SERVER
//['HTTPS'] lies about the browser-side security context. With
// DDMGMT_TRUST_PROXY=1 the X-Forwarded-Proto header decides (only the literal
// "https" counts, first hop of a comma list). Without proxy trust PHP's own
// view wins — never set the cookie "secure"-less on a proxy you trust.
function request_is_https(): bool {
    if (_secret('DDMGMT_TRUST_PROXY', '0') === '1') {
        $proto = strtolower(trim(explode(',', (string)($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? ''))[0]));
        if ($proto !== '') {
            return $proto === 'https';
        }
    }
    return !empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off';
}

// Overwrite file contents with null bytes before unlinking (best-effort)
function secure_unlink(string $path): void {
    if (!is_file($path)) return;
    try {
        $size = @filesize($path);
        if ($size > 0) {
            $fh = @fopen($path, 'r+');
            if ($fh !== false) {
                @fwrite($fh, str_repeat("\0", $size));
                @fflush($fh);
                @fclose($fh);
            }
        }
        @unlink($path);
    } catch (Throwable $t) {
        // Best-effort — silently ignore if file ops are restricted on this host
    }
}
